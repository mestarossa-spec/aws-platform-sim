# Terraform state files - never commit these
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform working directories
.terraform/
.terraform.lock.hcl

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
